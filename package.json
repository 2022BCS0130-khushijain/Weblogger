{
  "name": "inkwell",
  "version": "1.0.0",
  "description": "Backend-heavy blogging platform: auth, blogs, social, search, Redis, WebSocket chat, notifications",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "worker": "node src/worker.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test": "node --test test/api.test.js"
  },
  "dependencies": {
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
