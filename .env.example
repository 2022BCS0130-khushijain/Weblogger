# Copy this file to .env  (cp .env.example .env)
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000

DATABASE_URL=postgres://bloguser:blogpass@localhost:5432/blogdb
REDIS_URL=redis://localhost:6379

# Change this to a long random string in production!
JWT_SECRET=dev-secret-change-me

# Optional: enables the "Sign in with Google" button.
# Create one at https://console.cloud.google.com/apis/credentials (OAuth client ID, type "Web")
GOOGLE_CLIENT_ID=

# Run the background worker inside the API process (true = easiest).
# Set to false and run `npm run worker` separately in production.
RUN_WORKER_INLINE=true
